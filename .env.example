DATABASE_URL=
REDIS_URL=
SMTP_ENABLED=
SMTP_HOST=
SMTP_PORT=
SMTP_USE_SSL=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TO_EMAIL=
SMTP_TIMEOUT=

# 可覆盖 config/crawl.yaml 中的公共采集设置。
CRAWL_ENABLED=true
# NewsNow 和 OpenCLI 的并发上限。RAJ 并发在 crawl.yaml 的 RAJ 段设置。
CRAWL_CONCURRENCY=4
CRAWL_INTERVAL=1
CRAWL_TIMEOUT=20
CRAWL_RETRIES=2
# 可指定正常基线目录及检测阈值，以下 JSON 为可选示例。
# CRAWL_CHECKS={"baseline_dir":"/data/source_checks","field_drop":0.5,"count_ratio":0.2,"min_baseline_rows":10}

# AI API 设置，覆盖 filter.yaml 中的 ai.url 和 ai.api_key。
# URL 填写完整请求地址，包含服务商要求的版本路径和接口名。
FILTER_AI__URL=
FILTER_AI__API_KEY=

# AI 筛选同时处理的批次数（1～8）。
FILTER_AI__CONCURRENCY=2
# 单次 AI 请求最多包含的资讯条数（1～200）；长文本可能提前拆批。
FILTER_AI__BATCH_SIZE=12


# FastAPI：启用后，业务接口使用 Authorization: Bearer <API_KEY>。
API_AUTH_ENABLED=false
API_KEY=
# PostgreSQL 发件箱轮询间隔，以及未被领取的任务再次投递间隔。
TASK_QUEUE_NAME=interetread
TASK_WORKER_CONCURRENCY=1
TASK_POLL_INTERVAL=2
TASK_REDISPATCH_SECONDS=30
